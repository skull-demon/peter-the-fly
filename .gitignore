# FlyWire raw cache (large, re-downloadable, CC BY-NC licensed).
# Anchor to repo root: a bare `data/` would also exclude src/data/!
/data/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node / build
node_modules/
dist/
tests/.brain.build.mjs
tests/.talk-debug.mjs
.esbuild/

